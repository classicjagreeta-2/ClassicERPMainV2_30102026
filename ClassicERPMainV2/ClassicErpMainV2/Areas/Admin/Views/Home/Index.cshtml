@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<!-- Main Content Container -->
<div class="flex-1 flex flex-col min-w-0 overflow-hidden bg-slate-100">

    <!-- Header Bar -->
    <header class="bg-white border-b border-slate-200 py-2.5 px-4 sm:px-6 flex items-center justify-between gap-4 sticky top-0 z-20 shadow-sm">
        <!-- Global Search Bar -->
        <div class="relative w-full max-w-xs sm:max-w-md">
            <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2"></i>
            <input type="text" placeholder="Search licenses, users, or logs (Ctrl + K)..."
                   class="w-full pl-9 pr-4 py-1.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:border-brand-600 focus:ring-1 focus:ring-brand-600 focus:bg-white transition-all" />
        </div>

        <!-- System Status, Action Buttons & User Menu -->
        <div class="flex items-center gap-2 sm:gap-3 shrink-0">
            <!-- System Status Indicator -->
            <div class="hidden lg:flex items-center gap-2 px-2.5 py-1 bg-emerald-50 border border-emerald-200 rounded-lg text-[11px] text-emerald-700 font-semibold">
                <span class="relative flex h-2 w-2">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                </span>
                <span>All Systems Operational</span>
            </div>

            <!-- Quick Action Trigger Button -->
            <button type="button" onclick="openQuickActionModal()"
                    class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 bg-brand-600 hover:bg-brand-700 text-white rounded-lg text-xs font-semibold transition-all shadow-sm shadow-brand-600/20">
                <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                <span>Quick Action</span>
            </button>

            <!-- Notifications Button -->
            <div class="relative">
 
                <!-- Notifications Dropdown -->
                <div id="notificationsMenu" class="hidden absolute right-0 mt-2 w-80 bg-white border border-slate-200 rounded-xl shadow-xl z-50 p-3 space-y-2">
                    <div class="flex items-center justify-between pb-2 border-b border-slate-200">
                        <span class="text-xs font-bold text-slate-800">System Notifications</span>
                        <span class="text-[10px] text-brand-700 bg-brand-50 px-2 py-0.5 rounded border border-brand-200 font-semibold">3 Unread</span>
                    </div>
                    <div class="space-y-2 max-h-60 overflow-y-auto pr-1">
                        <div class="p-2 rounded-lg bg-slate-50 border border-slate-200 text-[11px] space-y-1">
                            <div class="flex justify-between text-slate-800 font-semibold">
                                <span>License Expiry Warning</span>
                                <span class="text-slate-400 text-[10px]">10m ago</span>
                            </div>
                            <p class="text-slate-600">Acme Corp license expires in 3 days.</p>
                        </div>
                        <div class="p-2 rounded-lg bg-slate-50 border border-slate-200 text-[11px] space-y-1">
                            <div class="flex justify-between text-slate-800 font-semibold">
                                <span>New High API Spike</span>
                                <span class="text-slate-400 text-[10px]">1h ago</span>
                            </div>
                            <p class="text-slate-600">API throughput spiked to 94% capability.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Refresh Button with Spin Effect -->
            <button type="button" onclick="refreshDashboardData()" title="Refresh Dashboard Data"
                    class="p-2 bg-slate-50 hover:bg-slate-100 border border-slate-200 rounded-xl text-slate-600 hover:text-slate-900 transition-all">
                <i id="btnRefreshDashboardIcon" data-lucide="refresh-cw" class="w-4 h-4"></i>
            </button>
        </div>
    </header>

