<!-- Quick Action Modal -->
<div id="quickActionModal" class="fixed inset-0 z-50 flex items-center justify-center hidden bg-slate-900/40 backdrop-blur-sm p-4">
    <div class="bg-white border border-slate-200 rounded-xl w-full max-w-md shadow-2xl overflow-hidden">
        <div class="px-5 py-3.5 border-b border-slate-200 bg-slate-50 flex items-center justify-between">
            <h3 class="text-sm font-bold text-slate-900 tracking-wide">Quick Action Wizard</h3>
            <button type="button" onclick="closeQuickActionModal()" class="text-slate-400 hover:text-slate-700 text-lg leading-none">&times;</button>
        </div>
        <div class="p-5 space-y-3">
            <label class="block text-xs font-semibold text-slate-700">Select Task Target</label>
            <select id="ddlQuickActionType" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-800 focus:outline-none focus:border-brand-600 focus:bg-white font-medium">
                <option value="new_user">Create New Admin User</option>
                <option value="issue_key">Issue New License Key</option>
                <option value="flush_cache">Flush Server Redis Cache</option>
            </select>
            <div class="space-y-1">
                <label class="block text-xs font-semibold text-slate-700">Action Notes / Reason</label>
                <input type="text" placeholder="e.g., Scheduled monthly maintenance"
                       class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:border-brand-600 focus:bg-white" />
            </div>
        </div>
        <div class="p-3 border-t border-slate-200 bg-slate-50 flex justify-end gap-2">
            <button type="button" onclick="closeQuickActionModal()" class="px-4 py-1.5 bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 rounded-lg text-xs font-semibold">Cancel</button>
            <button type="button" onclick="executeQuickAction()" class="px-4 py-1.5 bg-brand-600 hover:bg-brand-700 text-white rounded-lg text-xs font-semibold shadow-sm shadow-brand-600/20">Execute</button>
        </div>
    </div>
</div>