@model ClassicErpMainV2.Areas.Admin.Controllers.UserAccessIndexViewModel
@{    
    ViewBag.Title = "User Administration — User Rights for ";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var u = Model.SelectedUser;
}


<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title @(u.IsNewRecord ? "NEW" : u.UserOra)</title>
    <link href="~/Areas/Admin/Data/useraccess.css" rel="stylesheet" />
</head>
<body>
    <!-- Section Container -->
    <div class="space-y-4 max-w-7xl mx-auto p-0 sm:p-0">

        <!-- Top Header Bar -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-white border border-slate-200 py-2 px-3 rounded-xl shadow-sm">
            <div class="flex items-center gap-3">
                <div>
                    <h1 class="text-lg font-bold text-slate-900 tracking-tight leading-tight">
                        @(u.IsNewRecord ? "NEW USER" : u.UserOra)
                    </h1>
                </div>
            </div>

            <button type="button" id="btnBackToList" onclick="location.href='/Admin/UserAccess/List'" class="inline-flex items-center gap-2 bg-slate-50 hover:bg-slate-100 text-slate-700 hover:text-slate-900 px-3 py-1.5 rounded-lg text-xs font-semibold transition-all border border-slate-200 shadow-sm">
                <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i>
                <span>Back to List</span>
            </button>
        </div>

        <!-- Main Grid: Left User Form & Right Access Rights Tree -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-3">

            <!-- ============ LEFT CARD: USER DETAILS ============ -->
            <div class="lg:col-span-4 bg-white border border-slate-200 rounded-2xl p-4 shadow-sm space-y-3">
                <div class="flex items-center justify-between pb-3 border-b border-slate-200">
                    <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider">User Account</h3>
                    <span class="text-[11px] font-mono px-2.5 py-0.5 rounded-full bg-brand-50 text-brand-700 border border-brand-200 font-semibold">
                        @(u.IsNewRecord ? "Mode: Add" : "Mode: Edit")
                    </span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <!-- User Name / ORA -->
                    <div id="fldUserOra" class="space-y-1">
                        <label for="txtUserOra" class="block text-xs font-semibold text-slate-700">User Name (ORA)</label>
                        <input type="text" id="txtUserOra" maxlength="10" @(u.IsNewRecord ? "" : "readonly") value="@u.UserOra"
                               class="w-full px-3 py-1.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:border-brand-600 focus:bg-white transition-all disabled:opacity-60 disabled:bg-slate-100 font-medium" />
                        <div class="text-xs text-rose-600 font-medium" id="errUserOra"></div>
                    </div>

                    <!-- Group Dropdown -->
                    <div id="fldGroup" class="space-y-1">
                        <label for="ddlGroup" class="block text-xs font-semibold text-slate-700">Group</label>
                        <select id="ddlGroup" disabled class="w-full px-3 py-1.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 focus:outline-none focus:border-brand-600 focus:bg-white transition-all disabled:opacity-60 disabled:bg-slate-100 font-medium">
                            @foreach (var g in Model.Groups)
                            {
                                if (string.Equals(g, u.Group, StringComparison.OrdinalIgnoreCase))
                                {
                                    <option value="@g" selected="selected">@g</option>
                                }
                                else
                                {
                                    <option value="@g">@g</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <!-- Name -->
                <div id="fldUserName" class="space-y-1">
                    <label for="txtUserName" class="block text-xs font-semibold text-slate-700">Full Name</label>
                    <input type="text" id="txtUserName" @(u.IsNewRecord ? "" : "readonly") value="@u.UserName"
                           class="w-full px-3 py-1.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:border-brand-600 focus:bg-white transition-all disabled:opacity-60 disabled:bg-slate-100 font-medium" />
                    <div class="text-xs text-rose-600 font-medium" id="errUserName"></div>
                </div>

                <!-- Password Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div id="fldPassword" class="space-y-1">
                        <label for="txtPassword" class="block text-xs font-semibold text-slate-700">Password</label>
                        <input type="password" id="txtPassword" @(u.IsNewRecord ? "" : "readonly") value="@(u.IsNewRecord ? "" : u.Password)"
                               class="w-full px-3 py-1.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:border-brand-600 focus:bg-white transition-all disabled:opacity-60 disabled:bg-slate-100 font-medium" />
                        <div class="text-xs text-rose-600 font-medium" id="errPassword"></div>
                    </div>

                    <div id="fldPasswordConfirm" class="space-y-1">
                        <label for="txtPasswordConfirm" class="block text-xs font-semibold text-slate-700">Confirm Password</label>
                        <input type="password" id="txtPasswordConfirm" @(u.IsNewRecord ? "" : "readonly") value="@(u.IsNewRecord ? "" : u.Password)"
                               class="w-full px-3 py-1.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:border-brand-600 focus:bg-white transition-all disabled:opacity-60 disabled:bg-slate-100 font-medium" />
                        <div class="text-xs text-rose-600 font-medium" id="errPasswordConfirm"></div>
                    </div>
                </div>

                <!-- Action Badges / Toggles -->
                <div class="flex items-center gap-2 pt-1">
                    <button type="button" id="btnMail" disabled class="flex-1 py-1.5 px-3 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold text-slate-600 hover:text-slate-900 transition-all flex items-center justify-center gap-1.5 disabled:opacity-50">
                        <i data-lucide="mail" class="w-3.5 h-3.5 text-brand-600"></i> Mail
                    </button>
                    <button type="button" id="btnUnit" disabled class="flex-1 py-1.5 px-3 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold text-slate-600 hover:text-slate-900 transition-all flex items-center justify-center gap-1.5 disabled:opacity-50">
                        <i data-lucide="building-2" class="w-3.5 h-3.5 text-brand-600"></i> Unit
                    </button>
                    <button type="button" id="btnVoucher" disabled class="flex-1 py-1.5 px-3 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold text-slate-600 hover:text-slate-900 transition-all flex items-center justify-center gap-1.5 disabled:opacity-50">
                        <i data-lucide="ticket" class="w-3.5 h-3.5 text-brand-600"></i> Voucher
                    </button>
                </div>

                <!-- Policy Note -->
                <div id="pwdPolicyNote" class="p-2 bg-slate-50 border border-slate-200 rounded-xl text-[11px] leading-relaxed text-slate-600">
                    <span class="text-brand-600 font-bold">Policy:</span> Length Max @Model.PasswordPolicy.MaxLength, Min @Model.PasswordPolicy.MinLength &bull; Alpha: @Model.PasswordPolicy.MinAlphaChars &bull; Special: @Model.PasswordPolicy.MinSpecialChars &bull; Numeric: @Model.PasswordPolicy.MinNumericChars
                </div>

                <!-- Form Action Buttons -->
                <div class="pt-2 grid grid-cols-2 gap-2">
                    <button type="button" id="btnCancel" @(u.IsNewRecord ? "" : "disabled") class="py-2 bg-slate-100 hover:bg-slate-200 border border-slate-200 text-slate-700 rounded-xl text-xs font-semibold transition-all disabled:opacity-40">Cancel</button>
                    <button type="button" id="btnEdit" @(u.IsNewRecord ? "disabled" : "") class="py-2 bg-amber-500 hover:bg-amber-600 text-white rounded-xl text-xs font-semibold transition-all disabled:opacity-40 shadow-sm">Edit</button>
                    <button type="button" id="btnSave" @(u.IsNewRecord ? "" : "disabled") class="py-2 bg-brand-600 hover:bg-brand-700 text-white rounded-xl text-xs font-semibold transition-all disabled:opacity-40 shadow-sm shadow-brand-600/20">Save</button>
                    <button type="button" id="btnDelete" @(u.IsNewRecord ? "disabled" : "") class="py-2 bg-rose-600 hover:bg-rose-700 text-white rounded-xl text-xs font-semibold transition-all disabled:opacity-40 shadow-sm">Delete</button>
                </div>
            </div>

            <!-- ============ RIGHT CARD: ACCESS RIGHTS TREE ============ -->
            <div class="lg:col-span-8 bg-white border border-slate-200 rounded-2xl p-4 shadow-sm space-y-3 @(Model.IsNew == true ? "opacity-50 pointer-events-none" : "")">

                <!-- Toolbar -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-200">
                    <h2 id="lblViewingRights" class="text-xs font-bold text-slate-800 uppercase tracking-wider">
                        Viewing rights for <span class="text-brand-600">@u.UserOra</span> &middot; <span class="text-slate-500">@u.Group</span>
                    </h2>
                    <div class="flex items-center gap-1.5">
                        <button type="button" id="btnExpandAll" class="px-2.5 py-1 bg-slate-50 hover:bg-slate-100 border border-slate-200 text-slate-700 rounded-lg text-[11px] font-semibold transition-all">Expand All</button>
                        <button type="button" id="btnCollapseAll" class="px-2.5 py-1 bg-slate-50 hover:bg-slate-100 border border-slate-200 text-slate-700 rounded-lg text-[11px] font-semibold transition-all">Collapse All</button>
                        <input type="text" id="txtFilter" placeholder="Filter features..." class="px-2.5 py-1 bg-slate-50 border border-slate-200 rounded-lg text-[11px] text-slate-800 placeholder-slate-400 focus:outline-none focus:border-brand-600 focus:bg-white w-32 sm:w-40 font-medium" />
                    </div>
                </div>

                <!-- Two Column Context & Tree Content -->
                <div class="grid grid-cols-1 md:grid-cols-12 gap-4">

                    <!-- Left Context Selectors -->
                    <div class="md:col-span-5 space-y-3 bg-slate-50 p-3 rounded-xl border border-slate-200">
                        <div class="space-y-1">
                            <label for="ddlContextModule" class="block text-xs font-semibold text-slate-700">Module</label>
                            <select id="ddlContextModule" class="w-full px-3 py-1.5 bg-white border border-slate-200 rounded-lg text-xs text-slate-800 focus:border-brand-600 focus:outline-none font-medium">
                                <option value="">Please Select</option>
                                @foreach (var m in Model.Modules)
                                {
                                    <option data-menutable="@m.MENU_TABLE" data-usracstable="@m.USRACS_TABLE" data-unittable="@m.UNIT_TABLE" value="@m.MODULE_CODE">@m.MODULE_NAME</option>
                                }
                            </select>
                        </div>

                        @*<div class="grid grid-cols-2 gap-2">*@
                            <div class="space-y-1">
                                <label for="ddlContextCompany" class="block text-xs font-semibold text-slate-700">Company</label>
                                <select id="ddlContextCompany" class="w-full px-2.5 py-1.5 bg-white border border-slate-200 rounded-lg text-xs text-slate-800 focus:border-brand-600 focus:outline-none font-medium"><option value="">----</option></select>
                            </div>

                            <div class="space-y-1">
                                <label for="ddlContextYear" class="block text-xs font-semibold text-slate-700">Year</label>
                                <select id="ddlContextYear" class="w-full px-2.5 py-1.5 bg-white border border-slate-200 rounded-lg text-xs text-slate-800 focus:border-brand-600 focus:outline-none font-medium"><option value="">----</option></select>
                            </div>
                        @*</div>*@

                        <button type="button" id="btnLoadContext" class="w-full py-2 bg-brand-600 hover:bg-brand-700 text-white rounded-lg text-xs font-semibold transition-all shadow-sm shadow-brand-600/20">Load Context</button>
                    </div>

                    <!-- Right Rights Checkbox Bar & Tree Panel -->
                    <div class="md:col-span-7 space-y-2">
                        <!-- Global Checkbox Bar -->
                        <div id="selectAllRow" class="p-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-600 flex flex-wrap items-center gap-3">
                            <span class="font-bold text-slate-900 text-[10px] tracking-wider uppercase">SELECT ALL:</span>
                            <label class="inline-flex items-center gap-1 cursor-pointer font-medium"><input type="checkbox" id="chkAll" disabled class="rounded border-slate-300 bg-white text-brand-600 focus:ring-0" /> All</label>
                            <label class="inline-flex items-center gap-1 cursor-pointer font-medium"><input type="checkbox" id="chkAdd" disabled class="rounded border-slate-300 bg-white text-brand-600 focus:ring-0" /> Add</label>
                            <label class="inline-flex items-center gap-1 cursor-pointer font-medium"><input type="checkbox" id="chkEdit" disabled class="rounded border-slate-300 bg-white text-brand-600 focus:ring-0" /> Edit</label>
                            <label class="inline-flex items-center gap-1 cursor-pointer font-medium"><input type="checkbox" id="chkDelete" disabled class="rounded border-slate-300 bg-white text-brand-600 focus:ring-0" /> Delete</label>
                            <label class="inline-flex items-center gap-1 cursor-pointer font-medium"><input type="checkbox" id="chkView" disabled class="rounded border-slate-300 bg-white text-brand-600 focus:ring-0" /> View</label>
                        </div>

                        <!-- Tree Content Frame -->
                        <div id="treePanel" class="p-3 bg-slate-50 border border-slate-200 rounded-xl min-h-[220px] max-h-[380px] overflow-y-auto text-xs text-slate-800 font-medium">
                            <!-- Dynamic Tree JS content loads here -->
                        </div>
                    </div>

                </div>
            </div>

        </div>

        <!-- ============ MODAL 1: UNIT RIGHTS OVERLAY ============ -->
        <div id="unitModalOverlay" class="fixed inset-0 z-50 flex items-center justify-center hidden bg-slate-900/40 backdrop-blur-sm p-4">
            <div class="bg-white border border-slate-200 rounded-xl w-full max-w-lg shadow-2xl overflow-hidden">
                <!-- Modal Header with Close Button -->
                <div class="px-5 py-3 border-b border-slate-200 flex items-center justify-between bg-slate-50">
                    <div class="flex items-center gap-2">
                        <h3 class="text-sm font-bold text-slate-900 tracking-wide">User Wise Unit Rights</h3>
                        <span class="text-xs text-brand-600 font-semibold font-mono">Module Units</span>
                    </div>
                    <button type="button" id="btnCloseUnitModal" onclick="document.getElementById('unitModalOverlay').style.display='none';"
                            class="p-1 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition-colors text-lg leading-none" title="Close">
                        &times;
                    </button>
                </div>

                <!-- Modal Body & Table -->
                <div class="p-4 max-h-80 overflow-y-auto">
                    <table class="w-full text-left text-xs text-slate-700 border-collapse">
                        <thead class="bg-slate-50 text-slate-500 font-bold uppercase tracking-wider border-b border-slate-200">
                            <tr>
                                <th class="">#</th>
                                <th class="">Unit Code</th>
                                <th class="">Unit Name</th>
                                <th class="">
                                    <input type="checkbox" id="unitSelectAll" title="Select / Deselect All"
                                           class="rounded border-slate-300 bg-white text-brand-600 focus:ring-0 focus:ring-offset-0 cursor-pointer" />
                                </th>
                            </tr>
                        </thead>
                        <tbody id="unitGridBody" class="divide-y divide-slate-100 font-medium">
                            <!-- Populated dynamically via JS -->
                        </tbody>
                    </table>
                </div>

                <!-- Modal Footer -->
                <div class="p-3 border-t border-slate-200 bg-slate-50 flex justify-end">
                    <button type="button" id="unitLinkOk"
                            class="w-full py-2 bg-brand-600 hover:bg-brand-700 text-white rounded-lg text-xs font-semibold transition-all shadow-sm shadow-brand-600/20">
                        Ok
                    </button>
                </div>
            </div>
        </div>


        <!-- ============ MODAL 2: VOUCHER RIGHTS OVERLAY ============ -->
        <div id="voucherModalOverlay" class="fixed inset-0 z-50 flex items-center justify-center hidden bg-slate-900/40 backdrop-blur-sm p-4">
            <div class="bg-white border border-slate-200 rounded-xl w-full max-w-lg shadow-2xl overflow-hidden">
                <!-- Modal Header with Close Button -->
                <div class="px-5 py-3 border-b border-slate-200 flex items-center justify-between bg-slate-50">
                    <div class="flex items-center gap-2">
                        <h3 class="text-sm font-bold text-slate-900 tracking-wide">User Wise Voucher Right</h3>
                        <span class="text-xs text-brand-600 font-semibold font-mono">Voucher Types</span>
                    </div>
                    <button type="button" id="btnCloseVoucherModal" onclick="document.getElementById('voucherModalOverlay').style.display='none';"
                            class="p-1 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition-colors text-lg leading-none" title="Close">
                        &times;
                    </button>
                </div>

                <!-- Modal Body & Table -->
                <div class="p-4 max-h-80 overflow-y-auto">
                    <table class="w-full text-left text-xs text-slate-700 border-collapse">
                        <thead class="bg-slate-50 text-slate-500 font-bold uppercase tracking-wider border-b border-slate-200">
                            <tr>
                                <th class="">#</th>
                                <th class="">Type</th>
                                <th class="">Description</th>
                                <th class="">
                                    <input type="checkbox" id="voucherSelectAll" title="Select / Deselect All"
                                           class="rounded border-slate-300 bg-white text-brand-600 focus:ring-0 focus:ring-offset-0 cursor-pointer" />
                                </th>
                            </tr>
                        </thead>
                        <tbody id="voucherGridBody" class="divide-y divide-slate-100 font-medium">
                            <!-- Populated dynamically via JS -->
                        </tbody>
                    </table>
                </div>

                <!-- Modal Footer -->
                <div class="p-3 border-t border-slate-200 bg-slate-50 flex justify-end">
                    <button type="button" id="voucherLinkOk"
                            class="w-full py-2 bg-brand-600 hover:bg-brand-700 text-white rounded-lg text-xs font-semibold transition-all shadow-sm shadow-brand-600/20">
                        Ok
                    </button>
                </div>
            </div>
        </div>

        <!-- ============ MODAL 3: AEDV SETTINGS MODAL ============ -->
        <div id="aedvModal" class="fixed inset-0 z-50 flex items-center justify-center hidden bg-slate-900/40 backdrop-blur-sm p-4">
            <div class="bg-white border border-slate-200 rounded-xl w-full max-w-md shadow-2xl overflow-hidden">
                <!-- Modal Header -->
                <div class="px-5 py-3.5 border-b border-slate-200 bg-slate-50 flex items-center justify-between">
                    <h3 id="aedvModalTitle" class="text-sm font-bold text-slate-900 tracking-wide">AEDV Settings</h3>
                    <button type="button" id="btnCloseAedv" class="text-slate-400 hover:text-slate-700 text-lg transition-colors leading-none">&times;</button>
                </div>

                <!-- Modal Body -->
                <div class="p-5 space-y-3">
                    <label class="block text-xs font-semibold text-slate-700">
                        Enter unlocking periods in:
                    </label>
                    <div class="flex items-center gap-2">
                        <input type="number" id="txtLockDays" min="0" onkeydown="return event.key !== '-' && event.key !== 'e';" value="0"
                               class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-800 focus:outline-none focus:border-brand-600 focus:bg-white font-medium transition-all" />
                        <span class="text-xs font-bold text-slate-500 shrink-0">days</span>
                    </div>
                </div>

                <!-- Modal Footer -->
                <div class="p-3 border-t border-slate-200 bg-slate-50 flex justify-end">
                    <button type="button" id="btnAedvSave"
                            class="px-5 py-2 bg-brand-600 hover:bg-brand-700 text-white rounded-lg text-xs font-semibold transition-all shadow-sm shadow-brand-600/20">
                        Save Settings
                    </button>
                </div>
            </div>
        </div>

        <!-- ============ GLOBAL OVERLAY LOADER ============ -->
        <div id="globalLoader" class="fixed inset-0 top-0 left-0 right-0 bottom-0 w-screen h-screen z-[99999] flex items-center justify-center hidden bg-slate-900/50 backdrop-blur-md overflow-hidden">
            <div class="flex flex-col items-center justify-center text-center">
                <!-- Spinner -->
                <div class="w-10 h-10 border-4 border-brand-600 border-t-transparent rounded-full animate-spin shrink-0"></div>
                <!-- Loader Message -->
                <div id="globalLoaderText" class="mt-3 text-xs font-bold text-white tracking-wider drop-shadow-sm">Loading...</div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="~/Areas/Admin/Scripts/useraccess-tree.js"></script>

    <script>
        var currentUserOra = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(u.UserOra));
        var isNewUser = @Html.Raw(u.IsNewRecord ? "true" : "false");

        var passwordPolicy = {
            minLength: @Model.PasswordPolicy.MinLength,
            maxLength: @Model.PasswordPolicy.MaxLength,
            minAlpha: @Model.PasswordPolicy.MinAlphaChars,
            minSpecial: @Model.PasswordPolicy.MinSpecialChars,
            minNumeric: @Model.PasswordPolicy.MinNumericChars
        };

        var voucherRightRequired = @Html.Raw(Model.VoucherRightParaEnabled ? "true" : "false");

        var menuTreeData = []; //@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.MenuTree));
        var currentUserRights = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(u.Rights ?? new System.Collections.Generic.List < ClassicErpMainV2.Areas.Admin.Models.MenuRight > ()));


            var treePanel = document.getElementById('treePanel');
            var treePlaceholder = document.createElement('div');
            treePlaceholder.className = 'ua-tree-placeholder';
            treePlaceholder.textContent = 'Choose Module / Company / Year, then click Load to view rights.';
            treePanel.appendChild(treePlaceholder);


        var treeData = null;

        function resetTreeToPlaceholder() {
            treeData = null;
            treePanel.innerHTML = '';
            treePanel.appendChild(treePlaceholder);
        }

        function updateLoadButtonVisibility() {
            var hasAll = !!(ddlModule.value && ddlCompany.value && ddlYear.value);
            btnLoadContextEl.style.display = hasAll ? '' : 'none';
        }

        document.getElementById('btnExpandAll').addEventListener('click', function() {
            if (!treeData) return;
            UserAccessTree.expandAll(treeData);
        });
        document.getElementById('btnCollapseAll').addEventListener('click', function() {
            if (!treeData) return;
            UserAccessTree.collapseAll(treeData);
        });
        document.getElementById('txtFilter').addEventListener('input', function(e) {
            if (!treeData) return;
            UserAccessTree.filterTree(treeData, e.target.value);
        });

        [
            ['chkAll', 'all'],
            ['chkAdd', 'add'],
            ['chkEdit', 'edit'],
            ['chkDelete', 'delete'],
            ['chkView', 'view']
        ]
        .forEach(function(pair) {
            document.getElementById(pair[0]).addEventListener('change', function(e) {
                if (!treeData) return;
                UserAccessTree.selectAllColumn(treeData, pair[1], e.target.checked);
            });
        });

        var selectAllRow = document.getElementById('selectAllRow');
        var selectAllCheckboxes = document.querySelectorAll('#selectAllRow input[type=checkbox]');

        var readonlyToggleIds = ['txtUserName', 'txtPassword', 'txtPasswordConfirm'];
        var ddlGroupEl = document.getElementById('ddlGroup');

        var fieldErrorEls = {
            userOra: document.getElementById('errUserOra'),
            userName: document.getElementById('errUserName'),
            password: document.getElementById('errPassword'),
            passwordConfirm: document.getElementById('errPasswordConfirm')
        };
        var fieldWrapperEls = {
            userOra: document.getElementById('fldUserOra'),
            userName: document.getElementById('fldUserName'),
            password: document.getElementById('fldPassword'),
            passwordConfirm: document.getElementById('fldPasswordConfirm')
        };

        function setMode(mode) { // 'V' | 'E' | 'A'
            var editing = (mode === 'E' || mode === 'A' || mode === 'V');

                UserAccessTree.setEditable(editing);
                treePanel.classList.toggle('ua-readonly', !editing);
                selectAllRow.classList.toggle('ua-disabled', !editing);

                selectAllCheckboxes.forEach(function (cb) {
                    cb.disabled = !editing;
                });

            readonlyToggleIds.forEach(function(id) {
                var el = document.getElementById(id);
                if (editing) el.removeAttribute('readonly');
