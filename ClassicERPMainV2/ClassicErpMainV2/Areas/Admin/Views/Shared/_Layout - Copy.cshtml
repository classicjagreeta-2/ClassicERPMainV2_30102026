@using System.Web.Optimization
<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950 text-slate-100">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - SaaS Admin Portal</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#eeeefd',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                        }
                    }
                }
            }
        }
    </script>

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    @RenderSection("Styles", required: false)
</head>
<body class="h-full flex flex-col font-sans antialiased selection:bg-indigo-500 selection:text-white">

    <!-- Top Navigation Header -->
    <!-- Top Navigation Bar with Multi-Level Menus -->
    <header class="bg-slate-900 border-b border-slate-800 sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-14">

                <!-- Brand / Logo -->
                <a href="@Url.Action("Index", "SaaSAdmin", new { area = "Admin" })" class="flex items-center gap-3 group">
                    <div class="w-10 h-10 bg-white rounded-full p-1.5 flex items-center justify-center shrink-0 shadow-md shadow-navy-950/50 border border-slate-200/20">
                        <img src="~/Areas/Admin/Data/lg.png" alt="Logo" class="w-full h-full object-contain" />
                    </div>
                    <div>
                        <span class="font-bold text-lg text-white tracking-tight group-hover:text-brand-500 transition-colors">Admin Portal</span>
                        <span class="ml-2 text-[10px] font-mono px-2 py-0.5 rounded-md bg-navy-950 text-brand-500 border border-navy-800">Admin</span>
                    </div>
                </a>

                <!-- Multi-Menu Dropdowns Navigation -->
                <nav class="hidden md:flex items-center space-x-2">
                    <!-- Menu 1: Licensing & Companies (Dropdown) -->
                    <div class="relative group">
                        <button class="px-3 py-2 rounded-lg text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-800 transition-all flex items-center gap-2">
                            <i data-lucide="users" class="w-4 h-4 text-emerald-400"></i>
                            <span>Users & Permissions</span>
                            <i data-lucide="chevron-down" class="w-3.5 h-3.5 text-slate-500 group-hover:rotate-180 transition-transform"></i>
                        </button>
                        <div class="absolute left-0 mt-1 w-56 bg-slate-900 border border-slate-800 rounded-xl shadow-2xl py-2 hidden group-hover:block transition-all z-50">
                            <a href="javascript:void(0)" onclick="switchTab('sessions')" class="flex items-center gap-2 px-4 py-2 text-xs text-slate-300 hover:bg-emerald-600 hover:text-white transition-colors">
                                <i data-lucide="activity" class="w-4 h-4"></i> User Login Sessions
                            </a>
                            <a href="javascript:void(0)" class="flex items-center gap-2 px-4 py-2 text-xs text-slate-300 hover:bg-emerald-600 hover:text-white transition-colors">
                                <i data-lucide="user-x" class="w-4 h-4"></i> Force Terminations
                            </a>
                        </div>
                    </div>
                    <!-- Menu 2: User Access & Sessions (Dropdown) -->
                    <div class="relative group">
                        <button class="px-3 py-2 rounded-lg text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-800 transition-all flex items-center gap-2">
                            <i data-lucide="building-2" class="w-4 h-4 text-indigo-400"></i>
                            <span>Licensing</span>
                            <i data-lucide="chevron-down" class="w-3.5 h-3.5 text-slate-500 group-hover:rotate-180 transition-transform"></i>
                        </button>
                        <div class="absolute left-0 mt-1 w-52 bg-slate-900 border border-slate-800 rounded-xl shadow-2xl py-2 hidden group-hover:block transition-all z-50">
                            <a href="javascript:void(0)" onclick="switchTab('licenses')" class="flex items-center gap-2 px-4 py-2 text-xs text-slate-300 hover:bg-indigo-600 hover:text-white transition-colors">
                                <i data-lucide="award" class="w-4 h-4"></i> Company Licenses
                            </a>
                            <a href="javascript:void(0)" class="flex items-center gap-2 px-4 py-2 text-xs text-slate-300 hover:bg-indigo-600 hover:text-white transition-colors">
                                <i data-lucide="layers" class="w-4 h-4"></i> Plan Packages
                            </a>
                        </div>
                    </div>
                    <!-- Menu 3: System Administration (Dropdown) -->
                    <div class="relative group">
                        <button class="px-3 py-2 rounded-lg text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-800 transition-all flex items-center gap-2">
                            <i data-lucide="settings" class="w-4 h-4 text-amber-400"></i>
                            <span>System Settings</span>
                            <i data-lucide="chevron-down" class="w-3.5 h-3.5 text-slate-500 group-hover:rotate-180 transition-transform"></i>
                        </button>
                        <div class="absolute left-0 mt-1 w-52 bg-slate-900 border border-slate-800 rounded-xl shadow-2xl py-2 hidden group-hover:block transition-all z-50">
                            <a href="javascript:void(0)" class="flex items-center gap-2 px-4 py-2 text-xs text-slate-300 hover:bg-amber-600 hover:text-white transition-colors">
                                <i data-lucide="database" class="w-4 h-4"></i> DB Connections
                            </a>
                            <a href="javascript:void(0)" class="flex items-center gap-2 px-4 py-2 text-xs text-slate-300 hover:bg-amber-600 hover:text-white transition-colors">
                                <i data-lucide="file-text" class="w-4 h-4"></i> System Audit Logs
                            </a>
                        </div>
                    </div>

                </nav>

                <!-- Right Profile & Quick Status -->
                <div class="flex items-center gap-3">
                    <div class="hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-full bg-slate-950 border border-slate-800 text-xs text-slate-300">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                        <span class="font-mono text-slate-400">Oracle / SQL</span>
                    </div>

                    <div class="flex items-center gap-3 pl-3 border-l border-slate-800">
                        <div class="w-8 h-8 rounded-full bg-indigo-950 border border-indigo-700 flex items-center justify-center text-indigo-300 font-semibold text-xs">
                            SA
                        </div>
                        <button onclick="handleLogout()" class="p-1.5 text-slate-400 hover:text-rose-400 transition-colors" title="Logout">
                            <i data-lucide="log-out" class="w-4 h-4"></i>
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-2">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-slate-900 border-t border-slate-800/80 py-4 mt-auto">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-2">
            <div>&copy; @DateTime.Now.Year SaaS Management Portal. All rights reserved.</div>
            <div class="flex items-center gap-4">
                <span>MVC 4 + Oracle/SQL Server</span>
                <span>•</span>
                <span class="text-indigo-400 font-medium">Environment: Production</span>
            </div>
        </div>
    </footer>

    <!-- Global Layout Scripts -->
    <script>
        // Initialize Lucide Icons globally
        document.addEventListener("DOMContentLoaded", function () {
            if (window.lucide) {
                lucide.createIcons();
            }
        });

        // Global System Logout Prompt
        function handleLogout() {
            if (confirm("Are you sure you want to log out of the SaaS Admin Portal?")) {
                window.location.href = '@Url.Action("Logout", "Account", new { area = "" })';
            }
        }
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>