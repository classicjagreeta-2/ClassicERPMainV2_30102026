    function notifyServerIdle() {
        $.ajax({
            url: '@Url.Action( "UserIdleNotification", "Auth")',
            type: 'POST',
            dataType: 'json',
            success: function (response) {
                if (response.success) {
                    window.location.href = '@Url.Action("Login", "Auth")';
                }
            },
            error: function (xhr, status, error) {
                alert("Idle notification failed:" + error);
                console.error("Idle notification failed:", error);
            }
        });
    }
</script>

<script>
    $(document).ready(function () {
        // 1. Get Public IP using ipify via JavaScript
        $.getJSON('https://api.ipify.org?format=json', function (data) {
            var userIp = data.ip;
            $('#lblIp').text(userIp);
            // 2. Fetch Geolocation details based on that IP
            $.getJSON('http://ip-api.com/json/' + userIp, function (geo) {
                $('#lblAsn').text(geo.as);
                $('#lblIsp').text(geo.isp);
                $('#lblCountry').text(geo.country);
                $('#lblRegion').text(geo.regionName);
                $('#lblCity').text(geo.city);
                $('#lblLatLon').text(geo.lat + ', ' + geo.lon);
            });
        });
    });
</script>
