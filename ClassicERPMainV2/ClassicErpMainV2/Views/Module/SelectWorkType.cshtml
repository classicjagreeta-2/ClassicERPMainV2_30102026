@{
    Layout = null;

    var ccUser = ClassicErpMainV2.Utility.SessionHelper.GetUser();
    var ccUserName = ccUser.getUserfullName ?? "";
    var ccInitials = ccUserName.Length >= 2
        ? ccUserName.Substring(0, 2).ToUpper()
        : ccUserName.ToUpper();

    var ccLastLogin = ccUser.lastLoginDt.HasValue
        ? ccUser.lastLoginDt.Value.ToString("dd MMM yyyy, hh:mm tt")
        : "No previous login found";

    var ccModuleName = string.IsNullOrWhiteSpace(ViewBag.MName as string)
        ? "SELECT WORKING MODULE"
        : ViewBag.MName.ToString();

    var ccCloseUrl = Url.Action("SelectModule", "Module");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Classic ERP Payroll - @System.Configuration.ConfigurationManager.AppSettings["DatabaseType"]</title>
    <link rel="icon" href="~/Content/libraries/assets/images/faviconcc.ico" type="image/x-icon">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.8.1/css/all.css" crossorigin="anonymous">
    <style>

        .cc-context {
            display: flex !important;
            flex-direction: row !important;
            align-items: stretch !important;
            flex-wrap: nowrap !important;
            gap: 6px !important;
            width: 100% !important;
            min-width: 0 !important;
            margin-left: 1rem !important;
        }

        .cc-context-item {
            display: flex !important;
            align-items: center !important;
            gap: .45rem !important;
            flex: 1 1 50% !important;
            width: max-content !important;
            max-width: max-content !important;
            min-width: 0 !important;
            padding: .35rem .65rem !important;
            border-radius: 999px !important;
            background: var(--cc-navy-50) !important;
            color: var(--cc-navy) !important;
            font-size: .78rem !important;
            font-weight: 600 !important;
            overflow: hidden !important;
        }

            /* First badge stays on one line */
            .cc-context-item:first-child .cc-context-text {
                white-space: nowrap !important;
                overflow: hidden !important;
                text-overflow: ellipsis !important;
            }

            /* Second badge allows two lines */
            .cc-context-item:last-child .cc-context-text {
                white-space: normal !important;
                overflow-wrap: break-word !important;
                line-height: 1.25 !important;
                min-width: 0 !important;
            }

            .cc-context-item:last-child {
                align-items: center !important;
            }
        /* Keep user name in a single line */


        .cc-user {
            display: flex !important;
            align-items: center !important;
            flex: 0 0 auto !important;
            flex-wrap: nowrap !important;
            white-space: nowrap !important;
        }

        .cc-user-text {
            flex: 0 0 auto !important;
            white-space: nowrap !important;
            text-align: right !important;
        }

        .cc-user-name {
            white-space: nowrap !important;
            display: block !important;
            width: max-content !important;
            max-width: none !important;
        }

        .cc-user-role {
            white-space: nowrap !important;
        }

        :root {
            --cc-navy: #002164;
            --cc-navy-800: #0B2C73;
            --cc-navy-50: #EEF2FA;
            --cc-navy-100: #E1E8F5;
            --cc-orange: #FE4D00;
            --cc-orange-50: #FFF2EB;
            --cc-bg: #F5F7FB;
            --cc-border: #E3E8F2;
            --cc-muted: #5B6B8C;
            --cc-text: #0B1B3F;
            --cc-radius: 14px;
            --cc-shadow-sm: 0 1px 2px rgba(0,33,100,.06), 0 1px 3px rgba(0,33,100,.05);
            --cc-shadow-lg: 0 10px 24px rgba(0,33,100,.10), 0 24px 56px rgba(0,33,100,.10);
            --cc-ring: 0 0 0 .22rem rgba(254,77,0,.22);
            --cc-ease: 200ms cubic-bezier(.2,.7,.3,1);
        }

        *, *::before, *::after {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            min-height: 100%;
        }

        body {
            font-family: "Inter", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            background: radial-gradient(1100px 460px at 50% -160px, #E6ECF8 0%, transparent 70%), var(--cc-bg);
            color: var(--cc-text);
            -webkit-font-smoothing: antialiased;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        a {
            color: inherit;
        }

        .wrap {
            width: 100%;
            max-width: 1320px;
            margin: 0 auto;
            padding: 0 24px;
        }

        @@media (max-width: 575.98px) {
            .wrap {
                padding: 0 16px;
            }
        }

        /* Top bar */
        .cc-topbar {
            position: sticky;
            top: 0;
            z-index: 20;
            background: rgba(255,255,255,.9);
            backdrop-filter: saturate(160%) blur(10px);
            border-bottom: 1px solid var(--cc-border);
        }

            .cc-topbar .wrap {
                height: 68px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
            }

        .cc-brand {
            display: flex;
            align-items: center;
            min-width: 0;
        }

        .cc-context {
            display: flex;
            align-items: center;
            gap: .5rem;
            margin-left: 1rem;
            min-width: 0;
        }

        .cc-context-item {
            display: inline-flex;
            align-items: center;
            gap: .45rem;
            max-width: 360px;
            padding: .35rem .75rem;
            border-radius: 999px;
            background: var(--cc-navy-50);
            color: var(--cc-navy);
            font-size: .78rem;
            font-weight: 600;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

            .cc-context-item i {
                color: var(--cc-orange);
                font-size: .72rem;
                flex: none;
            }

        .cc-context-text {
            min-width: 0;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        @@media (max-width: 1199.98px) {
            .cc-context-item {
                max-width: 220px;
            }
        }

        @@media (max-width: 991.98px) {
            .cc-context {
                display: none;
            }
        }

        .cc-logo {
            display: block;
            width: 168px;
            height: auto;
            color: var(--cc-navy);
        }

            .cc-logo .cc-dot, .cc-logo .cc-tag {
                fill: var(--cc-orange);
            }

        .cc-product {
            font-size: .78rem;
            font-weight: 600;
            color: var(--cc-muted);
            border-left: 1px solid var(--cc-border);
            padding-left: 1rem;
            margin-left: 1rem;
            white-space: nowrap;
        }

        .cc-user {
            display: flex;
            align-items: center;
            gap: .75rem;
        }

        .cc-user-text {
            text-align: right;
        }

        .cc-user-name {
            font-weight: 600;
            font-size: .9rem;
            color: var(--cc-navy);
            line-height: 1.15;
        }

        .cc-user-role {
            font-size: .75rem;
            color: var(--cc-muted);
        }

        .cc-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            display: grid;
            place-items: center;
            background: var(--cc-navy);
            color: #fff;
            font-weight: 700;
            font-size: .8rem;
            box-shadow: 0 0 0 3px #fff, 0 0 0 4px var(--cc-border);
            flex: none;
        }

        .cc-close {
            display: inline-flex;
            align-items: center;
            gap: .45rem;
            height: 38px;
            padding: 0 .85rem;
            border-radius: 10px;
            border: 1px solid var(--cc-border);
            background: #fff;
            color: var(--cc-muted);
            font-size: .82rem;
            font-weight: 600;
            text-decoration: none;
            transition: all var(--cc-ease);
        }

            .cc-close:hover {
                color: var(--cc-orange);
                border-color: #FFD3BF;
                background: var(--cc-orange-50);
            }

            .cc-close:focus-visible {
                outline: none;
                box-shadow: var(--cc-ring);
            }

        @@media (max-width: 767.98px) {
            .cc-product {
                display: none;
            }
        }

        @@media (max-width: 575.98px) {
            .cc-user-text, .cc-close span {
                display: none;
            }

            .cc-logo {
                width: 132px;
            }
        }

        /* Stepper */
        .cc-stepper {
            display: flex;
            align-items: center;
            gap: .5rem;
            list-style: none;
            padding: 0;
            margin: 0;
            flex-wrap: wrap;
        }

        .cc-step {
            display: flex;
            align-items: center;
            gap: .5rem;
            font-size: .82rem;
            font-weight: 600;
            color: #8A97B3;
        }

        .cc-step-dot {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            display: grid;
            place-items: center;
            border: 2px solid #C9D2E3;
            background: #fff;
            font-size: .62rem;
        }

        .cc-step.is-done, .cc-step.is-current {
            color: var(--cc-navy);
        }

            .cc-step.is-done .cc-step-dot {
                background: var(--cc-navy);
                border-color: var(--cc-navy);
                color: #fff;
            }

            .cc-step.is-current .cc-step-dot {
                border-color: var(--cc-orange);
                box-shadow: 0 0 0 4px var(--cc-orange-50);
            }

                .cc-step.is-current .cc-step-dot::after {
                    content: "";
                    width: 8px;
                    height: 8px;
                    border-radius: 50%;
                    background: var(--cc-orange);
                }

        .cc-step-line {
            width: 40px;
            height: 2px;
            background: #D6DDEA;
            border-radius: 2px;
        }

            .cc-step-line.is-done {
                background: var(--cc-navy);
            }

        /* Head */
        .page-head {
            padding: 2.25rem 0 1.75rem;
            display: flex;
            flex-wrap: wrap;
            align-items: flex-end;
            justify-content: space-between;
            gap: 1rem 1.5rem;
        }

        .page-title {
            font-size: clamp(1.6rem, 2.2vw, 2.1rem);
            font-weight: 700;
            letter-spacing: -.02em;
            color: var(--cc-navy);
            margin: 1.25rem 0 .35rem;
        }

        .page-sub {
            color: var(--cc-muted);
            margin: 0;
            font-size: .95rem;
        }

            .page-sub strong {
                color: var(--cc-navy);
                font-weight: 600;
            }

        .search {
            position: relative;
            width: 300px;
            max-width: 100%;
        }

            .search i {
                position: absolute;
                left: .95rem;
                top: 50%;
                transform: translateY(-50%);
                color: #8A97B3;
                font-size: .9rem;
                pointer-events: none;
                transition: color var(--cc-ease);
            }

            .search input {
                width: 100%;
                font: inherit;
                font-size: .92rem;
                color: var(--cc-text);
                padding: .72rem .95rem .72rem 2.6rem;
                border: 1px solid var(--cc-border);
                border-radius: 10px;
                background: #fff;
                box-shadow: var(--cc-shadow-sm);
                outline: none;
                transition: border-color var(--cc-ease), box-shadow var(--cc-ease);
            }

                .search input::placeholder {
                    color: #9AA6BF;
                }

                .search input:focus {
                    border-color: var(--cc-orange);
                    box-shadow: var(--cc-ring);
                }

            .search:focus-within i {
                color: var(--cc-orange);
            }

        @@media (max-width: 767.98px) {
            .search {
                width: 100%;
            }
        }

        /* Module cards */
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 1.5rem;
        }

        @@media (max-width: 575.98px) {
            .grid {
                grid-template-columns: minmax(0, 1fr);
                gap: 1rem;
            }
        }

        .module-card {
            position: relative;
            display: flex;
            flex-direction: column;
            height: 100%;
            min-height: 190px;
            padding: 1.5rem 1.5rem 1.35rem;
            text-decoration: none;
            color: inherit;
            overflow: hidden;
            background: #fff;
            border: 1px solid var(--cc-border);
            border-radius: var(--cc-radius);
            box-shadow: var(--cc-shadow-sm);
            transition: transform var(--cc-ease), box-shadow var(--cc-ease), border-color var(--cc-ease);
        }

            .module-card::before {
                content: "";
                position: absolute;
                left: 0;
                top: 14px;
                bottom: 14px;
                width: 3px;
                border-radius: 0 3px 3px 0;
                background: var(--cc-orange);
                transform: scaleY(0);
                transition: transform var(--cc-ease);
            }

            .module-card:hover, .module-card:focus-visible {
                transform: translateY(-4px);
                box-shadow: var(--cc-shadow-lg);
                border-color: #D5DDEC;
                outline: none;
            }

            .module-card:focus-visible {
                box-shadow: var(--cc-shadow-lg), var(--cc-ring);
            }

                .module-card:hover::before, .module-card:focus-visible::before {
                    transform: scaleY(1);
                }

        .module-icon {
            width: 52px;
            height: 52px;
            border-radius: 14px;
            display: grid;
            place-items: center;
            background: var(--cc-navy-50);
            color: var(--cc-navy);
            font-size: 1.3rem;
            margin-bottom: 1.15rem;
            transition: background var(--cc-ease), color var(--cc-ease);
        }

        .module-card:hover .module-icon, .module-card:focus-visible .module-icon {
            background: var(--cc-orange-50);
            color: var(--cc-orange);
        }

        .module-title {
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--cc-navy);
            letter-spacing: -.01em;
            line-height: 1.35;
            margin-bottom: 1.25rem;
            text-transform: none;
        }

        .module-foot {
            margin-top: auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: .8rem;
            font-weight: 600;
            color: var(--cc-muted);
        }

        .module-tag {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
        }

            .module-tag .dot {
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background: #22A06B;
            }

        .badge-default {
            position: absolute;
            top: 1.1rem;
            right: 1.1rem;
            font-size: .68rem;
            font-weight: 600;
            color: var(--cc-orange);
            background: var(--cc-orange-50);
            border-radius: 999px;
            padding: .25rem .65rem;
        }

        .cc-context-label {
            font-size: .7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .04em;
            color: var(--cc-orange);
        }

        @@media (max-width: 575.98px) {
            .badge-default {
                position: static;
                order: 3;
                flex: none;
            }
        }

        .module-arrow {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: grid;
            place-items: center;
            background: var(--cc-navy);
            color: #fff;
            font-size: .8rem;
            opacity: 0;
            transform: translateX(-8px);
            transition: opacity var(--cc-ease), transform var(--cc-ease);
        }

        .module-card:hover .module-arrow, .module-card:focus-visible .module-arrow {
            opacity: 1;
            transform: translateX(0);
        }

        @@media (hover: none) {
            .module-arrow {
                opacity: 1;
                transform: none;
            }
        }

        @@media (max-width: 575.98px) {
            .module-card {
                min-height: 0;
                flex-direction: row;
                align-items: center;
                gap: 1rem;
                padding: 1rem 1.1rem;
            }

            .module-icon {
                margin: 0;
                flex: none;
                width: 46px;
                height: 46px;
                font-size: 1.15rem;
            }

            .module-title {
                margin: 0;
                flex: 1;
                font-size: 1rem;
            }

            .module-foot {
                margin: 0;
            }

            .module-tag {
                display: none;
            }

            .module-arrow {
                opacity: 1;
                transform: none;
            }
        }

        .empty {
            display: none;
            text-align: center;
            padding: 4rem 1rem;
            color: var(--cc-muted);
        }

            .empty i {
                font-size: 1.8rem;
                color: #B7C2D8;
            }

        main {
            flex: 1;
            padding-bottom: 3rem;
        }

        .cc-footer {
            font-size: .78rem;
            color: var(--cc-muted);
            padding-bottom: 1.5rem;
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: .5rem;
        }

        @@media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                transition: none !important;
            }
        }

        /* Work type cards use the same module-card design. */
        .work-type-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(260px, 340px));
            justify-content: center;
            gap: 1.5rem;
        }

        .work-type-card {
            min-height: 190px;
        }

            .work-type-card .module-icon {
                margin-bottom: 1.15rem;
            }

            .work-type-card .module-title {
                text-transform: none;
            }

        .work-type-intro {
            color: var(--cc-muted);
            margin: 0;
            font-size: .95rem;
        }

        @@media (max-width: 767.98px) {
            .work-type-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 575.98px) {
            .work-type-grid {
                grid-template-columns: minmax(0, 1fr);
                gap: 1rem;
            }

            .work-type-card {
                min-height: 0;
            }
        }
    </style>
</head>
<body>
    <header class="cc-topbar">
        <div class="wrap">
            <div class="cc-brand">
                <svg class="cc-logo" viewBox="0 0 600 165" role="img" aria-label="Classic Consultants">
                    <path d="M62 12 A50 50 0 0 0 62 112" fill="none" stroke="currentColor" stroke-width="12" />
                    <circle class="cc-dot" cx="62" cy="62" r="24" />
                    <text x="140" y="60" font-family="Inter, Arial, sans-serif" font-size="66" font-weight="700" fill="currentColor" letter-spacing="-1.5">classic</text>
                    <text x="140" y="118" font-family="Inter, Arial, sans-serif" font-size="66" font-weight="700" fill="currentColor" textLength="440" lengthAdjust="spacingAndGlyphs">consultants</text>
                    <text class="cc-tag" x="100" y="158" font-family="Inter, Arial, sans-serif" font-size="31" font-weight="500" textLength="436" lengthAdjust="spacing">solutions. not just softwares.</text>
                </svg>
                <span class="cc-product">Classic ERP</span>
                <span class="cc-context" title="@ccModuleName">
                    <span class="cc-context-item">
                        <i class="fas fa-th-large" aria-hidden="true"></i>
                        <span class="cc-context-text">@ccModuleName</span>
                    </span>
                </span>
            </div>
            <div class="cc-user">
                <div class="cc-user-text">
                    <div class="cc-user-name">@ccUserName</div>
                    <div class="cc-user-role">Signed in</div>
                </div>
                <div class="cc-avatar" aria-hidden="true">@ccInitials</div>
                <a href="@ccCloseUrl" class="cc-close" title="Back to modules" aria-label="Back to modules">
                    <i class="fas fa-arrow-left" aria-hidden="true"></i><span>Back</span>
                </a>
            </div>
        </div>
    </header>

    <main class="wrap">
        <div class="page-head">
            <div>
                <ol class="cc-stepper" aria-label="Progress">
                    <li class="cc-step is-done"><span class="cc-step-dot"><i class="fas fa-check"></i></span>Sign in</li>
                    <li class="cc-step-line is-done" aria-hidden="true"></li>
                    <li class="cc-step is-done"><span class="cc-step-dot"><i class="fas fa-check"></i></span>Module</li>
                    <li class="cc-step-line is-done" aria-hidden="true"></li>
                    <li class="cc-step is-current" aria-current="step"><span class="cc-step-dot"></span>Work Type</li>
                    <li class="cc-step-line" aria-hidden="true"></li>
                    <li class="cc-step"><span class="cc-step-dot"></span>Company</li>
                </ol>
                <h1 class="page-title">Choose your work type</h1>
                <p class="page-sub">
                    User Name : <strong>@ccUserName</strong>
                    &nbsp;&nbsp; Your Last Login Date : <strong>@ccLastLogin</strong>
                </p>
            </div>
        </div>

        <div class="work-type-grid">

            <!-- SALARY -->
            <a class="module-card work-type-card"
               href="@Url.Action("RedirectToModule", "Module", new {
           code = ViewBag.Code,
           controlschema = ViewBag.ControlSchema,
           menuschema = ViewBag.MenuSchema,
           sortby = ViewBag.SortBy,
           mname = ViewBag.MName,
           workType = "Salary"
       })">

                <div class="module-icon">
                    <i class="fas fa-money-check-alt" aria-hidden="true"></i>
                </div>

                <div class="module-title">Salary</div>

                <div class="module-foot">
                    <span class="module-tag">
                        <span class="dot"></span>Available
                    </span>

                    <span class="module-arrow">
                        <i class="fas fa-arrow-right" aria-hidden="true"></i>
                    </span>
                </div>
            </a>


            <!-- WAGES -->
            <a class="module-card work-type-card"
               href="@Url.Action("RedirectToModule", "Module", new {
           code = ViewBag.Code,
           controlschema = ViewBag.ControlSchema,
           menuschema = ViewBag.MenuSchema,
           sortby = ViewBag.SortBy,
           mname = ViewBag.MName,
           workType = "Wages"
       })">

                <div class="module-icon">
                    <i class="fas fa-briefcase" aria-hidden="true"></i>
                </div>

                <div class="module-title">Wages</div>

                <div class="module-foot">
                    <span class="module-tag">
                        <span class="dot"></span>Available
                    </span>

                    <span class="module-arrow">
                        <i class="fas fa-arrow-right" aria-hidden="true"></i>
                    </span>
                </div>
            </a>

        </div>
    </main>

    <footer class="wrap cc-footer">
        <span>� @DateTime.Now.Year Classic Consultants � solutions. not just softwares.</span>
        <span>Version @ViewContext.Controller.GetType().Assembly.GetName().Version.ToString(3)</span>
    </footer>
</body>
</html>
